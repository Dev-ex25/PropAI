rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validations
    function isValidListing(data) {
      return data.keys().hasAll(['address', 'price', 'realtorId']) &&
             data.address is string && data.address.size() > 0 && data.address.size() <= 500 &&
             data.price is number && data.price >= 0 &&
             data.realtorId == request.auth.uid;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'email', 'propertyId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.propertyId is string;
    }

    function isValidViewing(data) {
      return data.keys().hasAll(['propertyId', 'realtorId', 'date', 'time', 'buyerId']) &&
             data.propertyId is string &&
             data.realtorId is string &&
             data.date is string &&
             data.time is string &&
             data.buyerId is string;
    }

    // Listings
    match /listings/{listingId} {
      allow read: if true; // Public can see listings
      allow create: if isSignedIn() && isValidListing(incoming());
      allow update: if isSignedIn() && isOwner(existing().realtorId) && isValidListing(incoming());
      allow delete: if isSignedIn() && isOwner(existing().realtorId);
    }

    // Leads
    match /leads/{leadId} {
      allow create: if true; // Anyone can send a lead
      allow read, update: if isSignedIn() && (isOwner(existing().realtorId) || isOwner(incoming().realtorId)); 
      // Note: Lead might need realtorId to facilitate rules. Let's add it to schema.
    }

    // Viewings
    match /viewings/{viewingId} {
      allow read, write: if isSignedIn() && (isOwner(existing().realtorId) || isOwner(incoming().realtorId));
    }
  }
}
